diff --git a/hdl/jt6295_serial.v b/hdl/jt6295_serial.v
index 4dae4d3..9c5702f 100644
--- a/hdl/jt6295_serial.v
+++ b/hdl/jt6295_serial.v
@@ -71,11 +71,22 @@ end
 
 reg [17:0] cnt0, cnt1, cnt2, cnt3;
 
+// The busy flags follow the channel state register, and only change on the
+// cen4 edge that commits it (Kaneko16-Pocket, 2026-10-10). As written
+// upstream, busy[ch] took busy_in on every clock of the channel's turn, so a
+// STOP showed as "not busy" on the status port up to a whole cen4 period
+// before it was committed. Great 1000 Miles Rally polls the status after a
+// STOP and writes the next command's first byte the moment the bit drops;
+// that first byte clears the pending STOP in jt6295_ctrl, so the STOP was
+// lost, the old sample played on, and the 68000 spun on the status until it
+// ended: a 0.5-1 s freeze on every crash (sim/sound/tb_kaneko_oki.cpp, gtmr
+// section). With the flag changing only at the commit, a drop means the STOP
+// is in, and a START shows through `start` until its own commit.
 always @(posedge clk, posedge rst ) begin
     if( rst ) begin
         busy <= 4'd0;
     end else begin
-        case( ch )
+        if( cen4 ) case( ch )
             4'b0001: busy[0] <= busy_in;
             4'b0010: busy[1] <= busy_in;
             4'b0100: busy[2] <= busy_in;
